{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["eslint", "typescript", "oxc", "unicorn", "react", "nextjs", "jsx-a11y"],
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx,js,jsx}", "**/__tests__/**/*.{ts,tsx,js,jsx}"],
      "plugins": ["eslint", "typescript", "oxc", "unicorn", "react", "nextjs", "jest"],
      "rules": {
        "jest/no-conditional-expect": "off",
        "jest/no-focused-tests": "error"
      }
    },
    {
      "files": ["src/shared/**/*.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(entities|features|components|app)(/|$)",
                "message": "Shared modules must not import application or domain modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/lib/admin-session.ts", "src/shared/lib/admin-auth-config.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(entities|features|components|app)(/|$)|(^|/)(upload-request|admin-session)(\\.[^/]*)?$",
                "message": "Session configuration and signing must not depend on request authorization."
              }
            ]
          }
        ]
      }
    }
  ]
}
